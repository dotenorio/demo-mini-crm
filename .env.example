# Copie para .env.local. Sem nada configurado, a demo roda em modo local (./.dados) com login de demo.
MODO_DEMO=true
# Login do CRM (obrigatório se MODO_DEMO=false)
PAINEL_EMAIL=
PAINEL_SENHA=
# Obrigatório em produção: 32+ caracteres aleatórios
SESSAO_SEGREDO=
# Chave da API (/api/v1), 24+ caracteres. Sem ela: no modo demo usa uma chave pública; fora dele a API fica desligada.
CRM_API_CHAVE=
# Supabase (opcional): com isso, os dados vão para o PostgreSQL
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Schema onde ficam as tabelas (padrão: mini_crm). Ver supabase/schema.sql.
SUPABASE_SCHEMA=
